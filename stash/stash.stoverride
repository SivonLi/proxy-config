rules: #!replace
  # 提前拦截进入分流引擎的 IPv4 / IPv6 TCP、UDP 明文 DNS。
  - DST-PORT,53,REJECT,pre-matching
  # 全部域名规则先于 IP 规则；命中代理的 TCP 请求交给对应节点解析。
  - RULE-SET,lan,DIRECT
  - RULE-SET,lark,Lark
  - RULE-SET,ai,AI
  - RULE-SET,apple-intelligence,AI
  - RULE-SET,spotify,Spotify
  - DOMAIN-KEYWORD,-spotify-com,Spotify
  - RULE-SET,apple-cdn,DIRECT
  - RULE-SET,apple-cn,DIRECT
  - RULE-SET,apple-services,Apple
  - RULE-SET,microsoft-cdn,DIRECT
  - RULE-SET,microsoft,Microsoft
  - RULE-SET,stream,默认代理
  - RULE-SET,telegram,默认代理
  - RULE-SET,download-domain,下载
  - RULE-SET,download,下载
  - RULE-SET,direct,DIRECT
  - RULE-SET,domestic,DIRECT
  - RULE-SET,global,默认代理
  # 未命中域名规则时，通过国内 DoH 查询真实地址，供后续 IP 规则判断。
  - RULE-SET,lan-ip,DIRECT
  - RULE-SET,ai-ip,AI,no-resolve
  - RULE-SET,spotify-ip,Spotify,no-resolve
  - RULE-SET,apple-services-ip,Apple,no-resolve
  - RULE-SET,stream-ip,默认代理,no-resolve
  - RULE-SET,telegram-ip,默认代理,no-resolve
  - RULE-SET,domestic-ip,DIRECT,no-resolve
  - RULE-SET,china-ip,DIRECT
  - RULE-SET,china-ipv6,DIRECT
  - MATCH,默认代理
