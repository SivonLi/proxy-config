# 每个机场各保存一份本地文件，只修改机场名称和订阅地址。
proxy-providers:
  &airport_name '我的机场':
    url: 'https://example.invalid/replace-with-your-clash-subscription'
    interval: 86400
    benchmark-url: https://www.gstatic.com/generate_204
    benchmark-timeout: 5
    headers:
      User-Agent: Stash

# 复用上面的机场名称，供 Stash 覆写列表显示。
name: *airport_name
desc: '通过此覆写的开关控制该机场；分流与 DNS 使用主配置。'
category: '机场订阅'
